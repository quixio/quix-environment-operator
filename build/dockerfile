# Build stage
FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329 AS runtime-base

FROM golang:1.25.0@sha256:5502b0e56fca23feba76dbc5387ba59c593c02ccc2f0f7355871ea9a0852cebe AS trusted-tools
COPY trust/remove-rejected-cas.sh trust/rejected-roots.sha256 /trust/
RUN --network=none sh /trust/remove-rejected-cas.sh --policy /trust/rejected-roots.sha256

FROM trusted-tools AS runtime-trust
COPY --from=runtime-base /etc/ssl/certs/ca-certificates.crt /runtime/ca-certificates.crt
RUN --network=none sh /trust/remove-rejected-cas.sh --policy /trust/rejected-roots.sha256 --bundle /runtime/ca-certificates.crt --scan-root /runtime

FROM trusted-tools AS builder

WORKDIR /workspace

COPY go.mod go.sum ./
COPY hack/ ./hack/
COPY Makefile ./

RUN make setup-dev

# Copy the rest of the code
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY api/ ./api/
## zz files are generated by controller-gen and need to make sure
## they are correctly generated before running tests
RUN find ./api -type f -name "zz_*" -delete
COPY config/ ./config/
COPY LICENSE ./LICENSE

# Download dependencies pinned by the committed go.sum.
RUN go mod download

# Build
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 make build

# Runtime stage (minimal container)
FROM runtime-base
COPY --from=runtime-trust /runtime/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
WORKDIR /bin
COPY --from=builder /workspace/bin/operator .
USER nonroot:nonroot

ENTRYPOINT ["/bin/operator"]
