# Debian includes the sanitizer tools, so trust is filtered before any download.
FROM golang:1.25.0@sha256:5502b0e56fca23feba76dbc5387ba59c593c02ccc2f0f7355871ea9a0852cebe
COPY trust/remove-rejected-cas.sh trust/rejected-roots.sha256 /trust/
RUN --network=none sh /trust/remove-rejected-cas.sh --policy /trust/rejected-roots.sha256

# Set working dir
WORKDIR /app

COPY go.mod go.sum ./
COPY hack/ ./hack/
COPY Makefile ./

RUN make setup-dev

# Copy the rest of the code
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY api/ ./api/
## zz files are generated by controller-gen and need to make sure
## they are correctly generated before running tests
RUN find ./api -type f -name "zz_*" -delete
COPY config/ ./config/
COPY deploy/ ./deploy/

# Download dependencies and generate go.sum
RUN go mod download
RUN go mod tidy

RUN make build

# Run tests with specific flags to ensure freshly built code
ENTRYPOINT ["/bin/sh", "-c"]
CMD ["make test"]
